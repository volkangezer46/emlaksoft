{
  "id": "/",
  "name": "EmlakSoft",
  "short_name": "EmlakSoft",
  "description": "Türkiye'nin profesyonel emlak işletim sistemi",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#041127",
  "theme_color": "#071a38",
  "lang": "tr",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/brand/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Hızlı kayıt",
      "short_name": "Hızlı kayıt",
      "description": "Sahada müşteri, görüşme, randevu ya da portföy kaydı",
      "url": "/app/hizli",
      "icons": [
        {
          "src": "/brand/shortcut-hizli.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bugün",
      "short_name": "Bugün",
      "description": "Günün planı, randevular ve öncelikli işler",
      "url": "/app",
      "icons": [
        {
          "src": "/brand/shortcut-bugun.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Randevular",
      "short_name": "Randevular",
      "description": "Yaklaşan randevular ve takvim",
      "url": "/app/randevular",
      "icons": [
        {
          "src": "/brand/shortcut-randevu.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Görevler",
      "short_name": "Görevler",
      "description": "Açık ve geciken görevler",
      "url": "/app/gorevler",
      "icons": [
        {
          "src": "/brand/shortcut-gorev.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "prefer_related_applications": false,
  "share_target": {
    "action": "/app/paylas-al",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "text/vcard",
            "text/x-vcard",
            ".vcf"
          ]
        }
      ]
    }
  }
}
