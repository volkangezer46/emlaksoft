# engine-strict BILINCLI OLARAK KAPALI — tekrar acmadan once bunu okuyun.
#
# Denendi ve CI'i tamamen kirdi. Sebep:
#   @img/sharp-win32-ia32@0.35.3 kendi package.json'unda
#   engines: { "node": "^20.9.0" } bildiriyor. Caret oldugu icin bu
#   ">=20.9.0 <21.0.0" demek ve Node 24'u DISLIYOR. (sharp'in paketleme
#   hatasi; ">=20.9.0" demek istemis olmalilar.)
#
#   Paket optional + os:win32 + cpu:ia32, yani hicbir ortamda kurulmuyor.
#   Ama engine-strict lockfile metadata'sini dogruladigi icin `npm ci`
#   Linux runner'da patliyor ve type-check/lint/build hic calismiyor.
#
# Alakasiz bir bagimliligin metadata'siyla kirilabilen bir kapi, kotu kapidir.
# Node surumu zaten iki yerde korunuyor:
#   1) .nvmrc (=24) — CI setup-node bunu node-version-file ile okuyor
#   2) package.json "engines": ">=22.0.0" — npm yuksek sesle uyariyor
#
# Yeniden acmak isterseniz once sharp'in ia32 paketinin engines alanini
# kontrol edin; duzeltilmisse sorun kalmaz.
engine-strict=false
