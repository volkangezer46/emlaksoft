# Core Supabase runtime
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# Preferred browser credential: create an independently rotatable sb_publishable_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon JWT fallback only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server credential: create an independently rotatable sb_secret_ key.
SUPABASE_SECRET_KEY= # gitleaks:allow -- intentionally blank example value
# Legacy JWT fallback only; leave unset after migrating to SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Dedicated HMAC secret for the session-bound SMS 2FA proof cookie (32+ chars).
# Generate independently; never reuse Supabase API credentials.
TWO_FACTOR_COOKIE_SECRET=
# Dedicated HMAC pepper for every newly issued 6-digit login/signature OTP
# (32+ bytes). Keep independent from cookie, media and provider secrets.
OTP_HMAC_SECRET=
# Dedicated HMAC secret for short-lived private property media claims (32+ chars).
# Generate independently; do not reuse portal/share tokens or Supabase API keys.
PROPERTY_MEDIA_SIGNING_SECRET=

# Database tooling only; do not expose these to the Vercel runtime unless a
# controlled migration/audit job explicitly needs them.
DATABASE_POOLER_URL=
DATABASE_URL=

# Application and release identity
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Non-Vercel preview/test jobs may explicitly set EMLAKSOFT_ENV=preview|test.
# Local development is detected from NODE_ENV; production mode cannot be
# downgraded to local by a copied environment file.
NEXT_DEPLOYMENT_ID=
# Vercel supplies VERCEL_GIT_COMMIT_SHA automatically. RELEASE_SHA is the
# fallback for other hosts.
RELEASE_SHA=
# Generate these after the final migration is committed:
# npm run check:migrations -- --release
RELEASE_MIGRATION=
RELEASE_MIGRATION_CHECKSUM=

# Public lead endpoint CORS origins (comma separated)
LEAD_CORS_ORIGINS=

# Platform administration and development-only demo access
PLATFORM_ADMIN_EMAILS=
# Demo access is local-only; this example keeps it explicitly disabled. Set it
# to true only on a developer machine. Production build/start fails closed if
# this or any ALLOW_*_DEMO flag is enabled or has an unrecognized value.
ENABLE_DEMO_LOGIN=false
# Optional 32+ char secret for derived demo credentials. If empty, the
# Supabase server key is used server-side; neither value is exposed to clients.
DEMO_LOGIN_SECRET=

# Vercel cron authentication
CRON_SECRET=
# Required in production (32+ chars); protects detailed release/readiness data.
HEALTHCHECK_SECRET=

# Advisor identity data (TC no, IBAN) encryption key: 64 hex chars or 32-byte base64 (AES-256-GCM).
# If empty, these two fields stay disabled ("Etkin degil: anahtar tanimli degil"). LOSING THE KEY MAKES STORED
# VALUES UNRECOVERABLE; generate once with `openssl rand -hex 32` and keep it in the host's secret store.
ADVISOR_PII_KEY=

# Billing (optional in development, required for live subscriptions)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MERCHANT_ID=
# Sandbox-only escape hatches; keep false/unset in production.
ALLOW_PAYMENT_LINK_DEMO=false
ALLOW_BILLING_DEMO=false

# Valuation providers
ENDEKSA_CLIENT_ID=
ENDEKSA_CLIENT_SECRET=
ENDEKSA_BASE_URL=https://api.endeksa.com
# Exact comma-separated extra hosts for an approved sandbox/enterprise endpoint.
ENDEKSA_ALLOWED_HOSTS=
TAPUSOR_API_KEY=
TAPUSOR_BASE_URL=https://api.tapusor.com
TAPUSOR_ALLOWED_HOSTS=
BANK_RATES_API_KEY=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
AI_MEDIA_API_KEY=

# PWA push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@emlaksoft.com.tr

# Messaging
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_WEBHOOK_SECRET=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Tenant Meta Cloud phone/WABA identities and access tokens are verified and
# stored through Ayarlar; they are not accepted as shared process env values.
# Fail-closed by default. Set true only when the platform account is explicitly
# contracted to send on behalf of every tenant without its own provider record.
ALLOW_PLATFORM_MESSAGING_FALLBACK=false
# Optional comma-separated HTTPS origins for approved WhatsApp gateways.
WHATSAPP_ALLOWED_API_ORIGINS=

# Meta WhatsApp inbound webhook verification/signature
META_APP_SECRET=
META_VERIFY_TOKEN=
# Planned Lead Ads credential; the product flow remains disabled until its
# dedicated webhook, consent and provider acceptance contract is implemented.
META_PAGE_TOKEN=

# Listing portals (provider-specific secret/agency fields are optional)
SAHIBINDEN_API_KEY= # gitleaks:allow -- intentionally blank example value
SAHIBINDEN_API_SECRET=
SAHIBINDEN_AGENCY_ID=
SAHIBINDEN_BASE_URL=
SAHIBINDEN_ALLOWED_HOSTS=
HEPSIEMLAK_API_KEY=
HEPSIEMLAK_API_SECRET=
HEPSIEMLAK_AGENCY_ID=
HEPSIEMLAK_BASE_URL=
HEPSIEMLAK_ALLOWED_HOSTS=
ZINGAT_API_KEY=
ZINGAT_API_SECRET=
ZINGAT_AGENCY_ID=
ZINGAT_BASE_URL=
ZINGAT_ALLOWED_HOSTS=
EMLAKJET_API_KEY=
EMLAKJET_API_SECRET=
EMLAKJET_AGENCY_ID=
EMLAKJET_BASE_URL=
EMLAKJET_ALLOWED_HOSTS=

# Compliance / official integrations
TAKBIS_API_KEY=
IYS_API_KEY=
IYS_INTEGRATOR_TOKEN=

# E-invoice
EFATURA_PROVIDER=
EFATURA_API_URL=
EFATURA_ALLOWED_HOSTS=
EFATURA_API_KEY=
EFATURA_COMPANY_VKN=

# Local/CI tooling only
APP_URL=http://localhost:3000
E2E_MUTATION_ALLOWED=false
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
SEED_CONFIRM=
# Do not set NODE_ENV manually; Next.js selects development/test/production.
