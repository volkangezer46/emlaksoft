{
  "manifest_version": 3,
  "name": "EmlakSoft İlan Kontrol",
  "short_name": "EmlakSoft İlan",
  "version": "0.2.0",
  "description": "EmlakSoft açıkken sahibinden, Hepsiemlak ve Emlakjet ilanlarınızı yalnız sizin tarayıcınızda, düşük hızla kontrol eder.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": [],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EmlakSoft İlan Kontrol",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
