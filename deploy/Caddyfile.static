# Yalnız /_next/static: içerik adresli (hash'li) dosyalar, önceden sıkıştırılmış .br/.gz kopyalarıyla.
# Traefik bu yolu `emlaksoft-static` yönlendiricisiyle buraya verir (sıkıştırma ara katmanı YOK).
{
	admin off
	auto_https off
}
:8080 {
	handle_path /_next/static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server {
			precompressed br gzip
		}
	}
	handle {
		respond 404
	}
}
